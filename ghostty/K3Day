# K3Day for Ghostty, part of cosmic-k3day-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = K3Day
# or, with the K3 half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:K3,light:K3Day

background = #E5E6E6
foreground = #1A1B1B

cursor-color = #586065
cursor-text = #E5E6E6

selection-background = #CED0D0
selection-foreground = #1A1B1B

split-divider-color = #CED0D0
unfocused-split-fill = #E5E6E6

# black
